{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/_next/*",
      "/images/*",
      "/assets/*",
      "*.css",
      "*.js",
      "*.ico",
      "*.svg",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.webp",
      "*.txt",
      "*.xml",
      "*.json",
      "*.webmanifest"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "mimeTypes": {
    ".json": "application/json",
    ".webmanifest": "application/manifest+json"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
